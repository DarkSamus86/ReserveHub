# Local development defaults. Copy this file to .env only when overrides are needed.
POSTGRES_DB=reservehub
POSTGRES_USER=reservehub
POSTGRES_PASSWORD=reservehub
POSTGRES_PORT=5432
NATS_CLIENT_PORT=4222
NATS_MONITORING_PORT=8222
API_GATEWAY_PORT=8080
LOG_LEVEL=info
APP_ENV=local
# Generate a signing key pair once; keep the private key local and uncommitted:
#   mkdir -p secrets
#   openssl genpkey -algorithm ED25519 -out secrets/auth-jwt-private.pem
#   openssl pkey -in secrets/auth-jwt-private.pem -pubout -out secrets/auth-jwt-public.pem
#   chmod 600 secrets/auth-jwt-private.pem
AUTH_JWT_PRIVATE_KEY_FILE=./secrets/auth-jwt-private.pem
AUTH_JWT_PUBLIC_KEY_FILE=./secrets/auth-jwt-public.pem
# Generate once: openssl rand -hex 32 > secrets/platform-service-token && chmod 600 secrets/platform-service-token
PLATFORM_SERVICE_TOKEN_FILE=./secrets/platform-service-token
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AUTH_BOOTSTRAP_ADMIN_PASSWORD=<choose-a-unique-password-of-12-to-72-bytes>
# Optional owner invitation delivery. Keep these files outside version control.
# Generate a key once: openssl rand -hex 32 > secrets/auth-invitation-key && chmod 600 secrets/auth-invitation-key
# Store the SMTP password in secrets/auth-smtp-password with mode 600.
# AUTH_SMTP_ADDRESS=smtp.example.com:587
# AUTH_SMTP_FROM=invite@example.com
# AUTH_SMTP_USERNAME=invite@example.com
# AUTH_SMTP_PASSWORD_HOST_FILE=./secrets/auth-smtp-password
# AUTH_INVITATION_ENCRYPTION_KEY_HOST_FILE=./secrets/auth-invitation-key
# AUTH_INVITATION_LINK_BASE_URL=https://app.example.com/accept-invitation
AUTH_INVITATION_TTL=48h
AUTH_REFRESH_TTL=720h
